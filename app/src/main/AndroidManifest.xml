<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <queries>
        <package android:name="com.twitter.android" />
    </queries>

    <application
        android:name=".AtmacaNextApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_atmaca"
        android:label="Atmaca Next"
        android:roundIcon="@drawable/ic_atmaca"
        android:supportsRtl="true"
        android:theme="@style/Theme.AtmacaNext">

        <!--
          AndroidX Startup previously instantiated InitializationProvider before
          Application.onCreate. On affected MIUI installations the provider
          class landed in a secondary dex that was unavailable at that moment,
          crashing the process before the app could start. Remove the provider
          entirely; WorkManager is configured lazily by AtmacaNextApplication.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".automation.AtmacaAccessibilityService"
            android:exported="false"
            android:label="Atmaca Next Otomasyon Servisi"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".service.AutomationForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-visible host for user-started X/Twitter accessibility automation; pauses on screen-off/lock." />
        </service>

    </application>
</manifest>
