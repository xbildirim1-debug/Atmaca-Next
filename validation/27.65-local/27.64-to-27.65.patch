+
+    @Test fun profileCountersBehindAnOpenDrawerCannotHideTheConfirmedMenu() {
+        assertEquals(AccountProfileReturnPolicy.Action.READY,
+            AccountProfileReturnPolicy.decide(XScreen.ACCOUNT_DRAWER, true, false))
