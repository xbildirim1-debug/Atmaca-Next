+
+    @Test fun backTextInThePostBodyAndInvisibleArrowsAreRejected() {
+        val nodes = profile(listOf(
+            node(desc = "Geri", l = 30, t = 900, r = 120, b = 980),
+            node(desc = "Geri", l = 30, t = 100, r = 120, b = 180, visible = false),
